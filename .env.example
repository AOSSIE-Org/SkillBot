DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here
OLLAMA_MODEL=llama3.2
# Your organization's name, used in the bot's instructions to the model. Optional.
ORG_NAME=
SKILL_FILE_PATH=.clinerules
# Context window (tokens) for every Ollama call: system+prompt+response share this budget.
# 4096 matches this model's measured runtime default (`ollama ps` after a live call) on a
# machine with limited VRAM/RAM — raise only if you have headroom to spare, since it directly
# costs more memory and slows inference.
OLLAMA_NUM_CTX=4096



# --- Repository docs ---
# The bot copies the docs of the repositories listed in repo_metadata.py into repos/ at
# startup and then every SYNC_INTERVAL_HOURS (0 = only the startup sync).
SYNC_INTERVAL_HOURS=24
# Optional: any GitHub token, no scopes needed. Only matters if many entries in
# repo_metadata.py list folders in "docs" (GitHub allows 60 requests an hour without one).
GITHUB_TOKEN=

# On startup, answer missed questions only if they are newer than this many hours.
BACKLOG_MAX_AGE_HOURS=24
